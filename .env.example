# ── Tatum (onchain data) ─────────────────────────────────────────────
# Free key: https://dashboard.tatum.io  (used for Sui mainnet GraphQL gateway + Data API price)
TATUM_API_KEY=
# Optional overrides
# TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
# TATUM_DATA_URL=https://api.tatum.io
# If TATUM_API_KEY is empty the app falls back to the public Sui GraphQL endpoint (local dev only).
# Set to "false" to forbid that fallback in production.
# ALLOW_PUBLIC_SUI_FALLBACK=true

# ── Walrus Memory (long-term memory on Walrus mainnet) ───────────────
# From https://memory.walrus.xyz/dashboard → your agent → Delegate keys
MEMWAL_KEY=            # delegate PRIVATE key (hex, 0x-hex, or suiprivkey1…)
MEMWAL_ACCOUNT_ID=     # Walrus Memory account object id (0x…)
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# MEMWAL_NAMESPACE_PREFIX=sui-watchdog
# Without MEMWAL_KEY/MEMWAL_ACCOUNT_ID the app uses the SDK's in-memory MemWalMock.

# ── LLM (any OpenAI-compatible Chat Completions API) ────────────────
OPENAI_API_KEY=
# Switch providers by changing these three values only (no code changes):
#   Groq (free tier):  OPENAI_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
#   xAI Grok:          OPENAI_BASE_URL=https://api.x.ai/v1              LLM_MODEL=grok-4
#   OpenAI:            OPENAI_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OpenRouter / local Ollama also work (http://localhost:11434/v1)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Without a key the agent runs in deterministic rules-only mode.

# ── UI ───────────────────────────────────────────────────────────────
# Address pre-filled in the scan box (also the default for `npm run check` / `npm run seed`)
# WATCH_ADDRESS=0x...

# ── Rate limit (scan API) ────────────────────────────────────────────
# Per-IP scans allowed per hour. Default 20. Set to 0 to disable.
# The counter is in-memory and resets when a serverless instance recycles.
# RATE_LIMIT_PER_HOUR=20

# ── Auth (Sign in with Sui) ────────────────────────────────────────
# HMAC key for session cookies and stateless nonces. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Never commit the real value. Required in production for sign-in / labels.
SESSION_SECRET=
# Optional: pin the domain printed in the sign-in message (defaults to the request Host).
# AUTH_DOMAIN=sui-wallet-watchdog.netlify.app
